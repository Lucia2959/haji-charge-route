# 실제 값은 backend/.env 에 넣으세요 (.env 는 gitignore 됨). 이 파일에는 키를 넣지 마세요.

# Kakao REST API 키 (지도/경로/주소검색). 없으면 목(mock) 데이터로 동작
KAKAO_REST_API_KEY=

# 공공데이터포털 전기차 충전소 정보 서비스 키 (한국환경공단). 없으면 목 데이터로 동작
EV_STATION_API_KEY=

# 기온 자동입력은 Open-Meteo(키·신고 불필요) 사용 → 별도 키 없음

# CORS 허용 오리진. 로컬은 http://localhost:3000,
# 배포 시 프런트 주소로 변경 (예: https://haji-charge-route.vercel.app) — 슬래시 없이
FRONTEND_ORIGIN=http://localhost:3000

# 운영/개발 구분. production 이면 /docs·/health 상세를 비활성화
APP_ENV=development
# false 면 외부 API 실패 시 mock 폴백 대신 오류 반환(실주행 테스트용). 기본 true
MOCK_ENABLED=true

# 공유 시크릿. 설정하면 /api/* 요청에 X-Haji-Key 헤더를 요구한다.
# 프런트의 NEXT_PUBLIC_API_TOKEN 과 같은 값을 넣어야 한다. 비우면 검사하지 않음.
# 봇·스캐너의 쿼터 소모를 막는 1차 차단용(번들에 노출되므로 사람 대상 인증은 아님).
API_TOKEN=

# --- 성수기 충전 혼잡 예측 (docs/07) -----------------------------------------
# 비워두면 혼잡 예측 기능만 꺼지고 나머지는 그대로 동작한다.

# Postgres 접속 문자열 (Neon 또는 Supabase 무료 티어).
#   예: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/haji?sslmode=require
# SQLite를 쓰지 않는 이유: Render 무료는 파일시스템이 휘발성이라 재배포마다
# 수집 이력이 사라진다 → 콜드스타트가 끝나지 않는다.
DATABASE_URL=

# 수집 트리거(/internal/collect, /internal/aggregate) 전용 토큰.
# ⚠ API_TOKEN과 **반드시 다른 값**을 쓸 것 — API_TOKEN은 프런트 번들에 노출되므로,
#   그걸로 수집을 부를 수 있으면 누구나 공공 API 쿼터를 태울 수 있다.
COLLECT_TOKEN=

# 세션을 저장할 시군구. "zcode:zscode" 쉼표 구분. 비우면 회랑 기본값 19곳
# (서울 서초·강남 / 경기 성남·남양주·하남·용인·이천·광주·여주·가평 /
#  강원 춘천·원주·강릉·속초·홍천·횡성·평창·인제·양양)
# ⚠ 일반구 코드(41135 분당 등)는 공공 API에 없다 — 시 단위(41130)를 쓸 것.
COLLECT_DISTRICTS=

# 수집기 일일 호출 예산(자체 상한). 5분 주기 × 2페이지 = 576/일이라 2000이면 3배 여유.
# 계획 API가 쓸 쿼터를 수집기가 먼저 태우지 않게 하는 안전장치다.
COLLECT_DAILY_BUDGET=2000
