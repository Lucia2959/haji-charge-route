# 실제 값은 backend/.env 에 넣으세요 (.env 는 gitignore 됨). 이 파일에는 키를 넣지 마세요.

# Kakao REST API 키 (지도/경로/주소검색). 없으면 목(mock) 데이터로 동작
KAKAO_REST_API_KEY=

# 공공데이터포털 전기차 충전소 정보 서비스 키 (한국환경공단). 없으면 목 데이터로 동작
EV_STATION_API_KEY=

# 기온 자동입력은 Open-Meteo(키·신고 불필요) 사용 → 별도 키 없음

# CORS 허용 오리진. 로컬은 http://localhost:3000,
# 배포 시 프런트 주소로 변경 (예: https://haji-charge-route.vercel.app) — 슬래시 없이
FRONTEND_ORIGIN=http://localhost:3000

# 운영/개발 구분. production 이면 /docs·/health 상세를 비활성화
APP_ENV=development
# false 면 외부 API 실패 시 mock 폴백 대신 오류 반환(실주행 테스트용). 기본 true
MOCK_ENABLED=true

# 공유 시크릿. 설정하면 /api/* 요청에 X-Haji-Key 헤더를 요구한다.
# 프런트의 NEXT_PUBLIC_API_TOKEN 과 같은 값을 넣어야 한다. 비우면 검사하지 않음.
# 봇·스캐너의 쿼터 소모를 막는 1차 차단용(번들에 노출되므로 사람 대상 인증은 아님).
API_TOKEN=
