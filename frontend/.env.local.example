# 실제 값은 frontend/.env.local 에 넣으세요 (.env.local 은 gitignore 됨). 이 파일에는 키를 넣지 마세요.

# 백엔드(FastAPI) 주소 — 빌드 타임에 번들로 주입된다.
#   로컬:  http://localhost:8000
#   배포:  https://<백엔드도메인>   ← 반드시 https. http면 아이폰 Safari가 mixed content로
#                                    전부 차단하고, localhost는 아이폰에서 자기 자신을
#                                    가리켜 100% 실패한다.
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Kakao JavaScript 키 (지도 표시용). 없으면 지도 자리에 텍스트 폴백 표시.
# Kakao Developers > 내 앱 > 플랫폼 > Web 에 배포 도메인을 등록해야 지도가 뜬다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 백엔드 공유 시크릿 (backend 의 API_TOKEN 과 같은 값). 비우면 검사하지 않음.
# 번들에 노출되므로 사람 대상 인증이 아니라, URL을 모르는 봇·스캐너가 백엔드를 직접
# 두드려 외부 API 쿼터를 태우는 것을 막는 1차 차단용이다.
NEXT_PUBLIC_API_TOKEN=

# 참고: 즐겨찾기(집·회사) 주소는 더 이상 환경변수로 두지 않는다.
# NEXT_PUBLIC_* 은 빌드 산출물에 문자열로 그대로 박혀 배포 URL만 알면 읽을 수 있다.
# 앱 화면의 "＋ 즐겨찾기" 버튼으로 등록하면 기기 localStorage 에만 저장된다.
